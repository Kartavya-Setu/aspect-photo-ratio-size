# Optional environment configuration
# AspectShift runs 100% client-side in the browser.

# APP_URL: Optional base URL where the application is hosted
APP_URL="http://localhost:4200"

# Google Gemini API Key for the AI Command Copilot
# Get your free key at: https://aistudio.google.com/app/apikey
# If left blank, AspectShift automatically uses fast offline heuristics.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
